# ==========================================
# MomOi Healthcare AI - Environment Configuration
# ==========================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=momoidb

# AI Services (Google Gemini)
# Lấy API Key tại: https://aistudio.google.com/
GEMINI_API_KEY=

# Nutrition Data API (USDA)
# Đăng ký lấy key tại: https://fdc.nal.usda.gov/api-key-signup.html (Mặc định dùng DEMO_KEY)
USDA_API_KEY=DEMO_KEY

# JWT Authentication (Tùy chọn - nếu để trống hệ thống sẽ tự sinh in-memory developer key)
Jwt__Issuer=MomOiAPI
Jwt__Audience=MomOiFrontend
Jwt__PrivateKey=
Jwt__PublicKey=

# Email SMTP (MailKit - Tùy chọn)
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__EnableSsl=true

# Twilio SMS (Tùy chọn)
Twilio__AccountSid=
Twilio__AuthToken=
Twilio__FromPhoneNumber=

# Payment Gateways (Tùy chọn cho MoMo / VNPay)
Payment__MoMo__PartnerCode=MOMO
Payment__MoMo__AccessKey=
Payment__MoMo__SecretKey=
Payment__VnPay__TmnCode=JOROVPPF
Payment__VnPay__HashSecret=
